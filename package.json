{
  "name": "atproto-client",
  "version": "0.1.0",
  "description": "Server-side AT Protocol Spaces client extracted from loftet-social",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.16 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.8.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "PROVENANCE.md"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "prettier": "3.10.0",
    "typescript": "7.0.2"
  }
}
